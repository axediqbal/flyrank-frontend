# Environment variables — structure only. Copy to .env.local for local dev.
# No secrets are committed to this repository; production values live in
# the Vercel project's Environment Variables settings.

# Public URL of this site (used for metadata / canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Streaming chat (FE-06) — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_
# and never commit a real value. While this is unset, /api/chat runs in an
# honestly-badged demo mode (scripted replies, same streaming behaviour).
# Get a free key from Google AI Studio; set it in Vercel → Settings →
# Environment Variables for production.
GEMINI_API_KEY=
